# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Cache & Compiled Files
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Local Configuration & Secrets
.env
app_startup.log
app_startup.log.*

# IDE & Editor Files
.vscode/
.idea/
