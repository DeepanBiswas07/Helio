# Local Application Data & Personal Memory (GitIgnore)
# Everything Helio writes at runtime: memory, schedule, builds, the workshop
# layout and pictures fetched from the web. Recreated on first run.
data/

# Biometric & Face Recognition Data (GitIgnore)
gesture/faces.pt

# Large AI Model Cache Policies
# Ignore Ollama model blobs and manifests
models/blobs/
models/manifests/

# Ensure core light model files and Kokoro TTS models are tracked
!models/helio.onnx
!models/helio.tflite
!models/tts/
