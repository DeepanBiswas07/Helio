# ──────────────────────────────────────────────────────────────────────────
# HELIO CONFIGURATION ENVIRONMENT VARIABLES
# ──────────────────────────────────────────────────────────────────────────

# Local Ollama endpoint
OLLAMA_URL=http://localhost:11434/api/generate

# Cognitive Model Roles
# Set these to Ollama models you have pulled (`ollama pull <model>`).
# Cloud models change over time — check `ollama list` / ollama.com for what's current,
# and note some cloud tags require a paid Ollama subscription (test with a raw
# /api/generate call before relying on one — a 402/subscription error means it's gated).
# Measured on the free tier: gpt-oss:120b answers a routing prompt in
# 2.0s, nemotron-3-nano in 3.1s. The big one is the fast one.
FAST_MODEL=gpt-oss:120b-cloud
HEAVY_MODEL=gpt-oss:120b-cloud
LOCAL_MODEL=llama3:8b

# Multimodal model for "what's on my screen?".
# NOTE: this is the one Helio feature that leaves your machine — the
# screenshot is uploaded to this model. No locally installed model can
# read an image (llama3:8b is text-only). To keep it fully offline,
# `ollama pull qwen2.5vl:3b` and set VISION_MODEL=qwen2.5vl:3b.
VISION_MODEL=gemma4:cloud

# ── Voice ──────────────────────────────────────────────────────────────────
# Microphone. Left unset, Helio listens to each mic for half a second at
# startup and uses the best one that actually carries sound. Set a name
# fragment or a device index to force one, e.g. HELIO_MIC=Microphone Array
# HELIO_MIC=

# "Hey Helio, open Chrome" in one breath: the wake word model misses the name
# when a command follows without a pause, so the first 1.6 s of each sentence
# is also checked with Whisper (in memory, nothing kept). 0 turns that off.
# HELIO_WAKE_WHISPER=1

# Speech-to-text model. large-v3-turbo is more accurate with names and accents
# but is a ~1.6 GB download and uses more of the GPU.
# HELIO_STT_MODEL=distil-medium.en
